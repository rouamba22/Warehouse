      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 Container — Warehouse" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="480" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="staff" value="Warehouse staff&#10;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#083F75;fontColor=#ffffff;strokeColor=#052C53;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="boundary" value="Warehouse System" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#ffffff;strokeColor=#1168BD;dashed=1;fontSize=14;fontStyle=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="860" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="spa" value="Web app&#10;[Container: Vue 3 + Vuetify]&#10;Screens in docs/ui.&#10;Sends the session token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="230" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API&#10;[Container: Node, Express, Sequelize]&#10;/warehouse&#10;Checks role. Hides private fields." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="590" y="240" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="Database&#10;[Container: MySQL]&#10;staff, sessions, customers,&#10;suppliers, items, orders, counts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="910" y="230" width="180" height="160" as="geometry"/>

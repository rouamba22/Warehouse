<mxfile host="app.diagrams.net" type="device">
  <diagram id="c4-deployment" name="Deployment">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 Deployment — Warehouse (class)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="560" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="One class machine runs the API and MySQL. Staff open the web app in a browser. This is not a multi-site production deploy." style="text;html=1;fontSize=13;align=left;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="720" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="pc" value="Staff PC" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#ffffff;strokeColor=#083F75;fontSize=14;fontStyle=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="360" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="Browser&#10;[Deployment node]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#083F75;fontColor=#ffffff;strokeColor=#052C53;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="spa" value="Web app&#10;[Vue 3]&#10;docs/ui screens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="host" value="Class server" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#ffffff;strokeColor=#1168BD;fontSize=14;fontStyle=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="640" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API process&#10;[Node]&#10;Express mounted at /warehouse&#10;Role checks on every route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="260" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="MySQL&#10;[Database]&#10;One database for the warehouse" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="840" y="200" width="220" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS JSON&#10;Authorization: Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="spa" target="api">
          <mxGeometry relative="1" as="geometry"/>
